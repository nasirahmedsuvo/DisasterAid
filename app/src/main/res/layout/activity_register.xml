<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Join DisasterAid"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#173B64"
                    android:gravity="center"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Create your account and help your community"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:textColor="#7B8798"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="28dp"/>

                <EditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Full Name"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="16dp"
                    android:textColor="#243247"
                    android:textColorHint="#7B8798"
                    android:backgroundTint="#16A085"
                    android:layout_marginBottom="14dp"/>

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Email Address"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="16dp"
                    android:textColor="#243247"
                    android:textColorHint="#7B8798"
                    android:backgroundTint="#16A085"
                    android:layout_marginBottom="14dp"/>

                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Phone Number"
                    android:inputType="phone"
                    android:paddingHorizontal="16dp"
                    android:textColor="#243247"
                    android:textColorHint="#7B8798"
                    android:backgroundTint="#16A085"
                    android:layout_marginBottom="14dp"/>

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Password (min 6 characters)"
                    android:inputType="textPassword"
                    android:paddingHorizontal="16dp"
                    android:textColor="#243247"
                    android:textColorHint="#7B8798"
                    android:backgroundTint="#16A085"
                    android:layout_marginBottom="14dp"/>

                <Spinner
                    android:id="@+id/spinnerRole"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="24dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Create Account"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="#16A085"
                    app:cornerRadius="12dp"
                    app:elevation="2dp"/>

                <TextView
                    android:id="@+id/tvGoLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Already have an account? Login"
                    android:textColor="#173B64"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="16dp"
                    android:layout_marginTop="12dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
